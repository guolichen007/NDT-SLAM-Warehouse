<launch>
    <!-- 长期运行建图模式 -->
    <!-- 用途：雷达常开，天车静止时不重复建图，天车移动时增量落盘 -->
    <!-- v8-stable-r3: 一个 launch 启动两个节点：ndt_slam_node + cargo_core_box_visualizer -->

    <!-- 参数 -->
    <arg name="use_sim_time" default="false"/>
    <arg name="use_rviz" default="true"/>
    <!-- Legacy compatibility visualizer is opt-in. The authoritative marker is
         /cargo_avoidance/fused_box_marker from the typed fusion pipeline. -->
    <arg name="use_cargo_visualizer" default="false"/>
    <arg name="ndt_publish_cargo_markers" default="false"/>
    <arg name="publish_rslidar_tf" default="true"/>
    <arg name="persistent_map" default="true"/>
    <arg name="odom_anchored_cargo_box_enabled" default="true"/>
    <arg name="hook_cargo_removal_enabled" default="true"/>
    <arg name="cargo_warning_enabled" default="true"/>
    <arg name="use_cargo_alarm_heartbeat" default="true"/>
    <arg name="use_ndt_recovery_watchdog" default="true"/>
    <!-- Optional override for all nodes that read live_longterm_mapping.yaml.
         Default keeps the original path; bag harness passes a sandbox copy. -->
    <arg name="config_file" default="$(find ndt_slam)/config/live_longterm_mapping.yaml"/>
    <arg name="cargo_vertical_evidence_config_file"
         default="$(find ndt_slam)/config/cargo_vertical_evidence_v2.yaml"/>

    <!-- Debounce and classify the hook load-cell voltage before SLAM uses it. -->
    <node name="hook_load_state"
          pkg="ndt_slam"
          type="hook_load_state_node"
          output="screen">
        <param name="config_file" value="$(arg config_file)"/>
    </node>

    <!-- 设置使用真实时间（现场必须） -->
    <param name="/use_sim_time" value="$(arg use_sim_time)"/>

    <!-- SLAM 节点（主节点：建图、定位、动态过滤） -->
    <node name="ndt_slam_node" pkg="ndt_slam" type="ndt_slam_node" output="screen">
        <param name="config_file" value="$(arg config_file)"/>
        <param name="cargo_vertical_evidence_config_file"
               value="$(arg cargo_vertical_evidence_config_file)"/>
        <param name="ndt_publish_cargo_markers" value="$(arg ndt_publish_cargo_markers)"/>
        <!-- YAML supplies conservative defaults; these launch arguments are
             explicit production overrides and must be visible in ~params. -->
        <param name="persistent_map_enabled" value="$(arg persistent_map)"/>
        <param name="odom_anchored_cargo_box_enabled"
               value="$(arg odom_anchored_cargo_box_enabled)"/>
        <param name="hook_cargo_removal_enabled"
               value="$(arg hook_cargo_removal_enabled)"/>
        <param name="cargo_warning_enabled"
               value="$(arg cargo_warning_enabled)"/>
    </node>

    <!-- A required node is used deliberately: after bounded in-process
         recovery fails, exit 75 tears down this roslaunch. The production
         systemd unit restarts the entire stack and the watchdog records the
         cause before exiting. -->
    <node name="ndt_recovery_watchdog"
          pkg="ndt_slam"
          type="ndt_recovery_watchdog.py"
          output="screen"
          required="true"
          if="$(arg use_ndt_recovery_watchdog)">
        <param name="status_topic" value="/ndt_slam/relocalization_status"/>
        <param name="relocalize_service" value="/ndt_slam/relocalize"/>
        <param name="startup_grace_sec" value="30.0"/>
        <param name="soft_relocalize_after_sec" value="8.0"/>
        <param name="hard_restart_after_sec" value="45.0"/>
        <param name="hard_restart_bad_frames" value="300"/>
        <param name="hard_restart_bad_frames_after_sec" value="15.0"/>
        <param name="healthy_reset_sec" value="10.0"/>
        <param name="restart_window_sec" value="900.0"/>
        <param name="max_restarts_in_window" value="3"/>
    </node>

    <!-- Formal status heartbeat. safety_status is authoritative; status_code
         is the optional simple-code interface. -->
    <node name="cargo_alarm_heartbeat"
          pkg="ndt_slam"
          type="cargo_alarm_heartbeat_node"
          output="screen"
          if="$(arg use_cargo_alarm_heartbeat)">
        <param name="status_topic" value="/cargo_avoidance/safety_status"/>
        <param name="status_queue_size" value="1"/>
        <param name="status_code_topic" value="/cargo_avoidance/status_code"/>
        <param name="publish_legacy_alarm_topic" value="false"/>
        <param name="legacy_alarm_topic" value="/cargo_avoidance/alarm_code"/>
        <param name="heartbeat_hz" value="5.0"/>
        <param name="stale_timeout_sec" value="0.8"/>
        <param name="pending_error_sec" value="5.0"/>
        <param name="pending_repeat_sec" value="10.0"/>
        <param name="warning_repeat_sec" value="5.0"/>
        <param name="level1_distance_m" value="3.0"/>
        <param name="level2_distance_m" value="5.0"/>
        <param name="minimum_vertical_clearance_m" value="0.80"/>
    </node>

    <!-- Cargo 可视化节点（只订阅 /payload_track_info，发布 /cargo_core_bbox_marker） -->
    <node name="cargo_core_box_visualizer"
          pkg="ndt_slam"
          type="cargo_forbidden_zone_node"
          output="screen"
          if="$(arg use_cargo_visualizer)">
        <param name="config_file" value="$(find ndt_slam)/config/cargo_forbidden_zone.yaml"/>
        <param name="marker_frame" value="map"/>
        <param name="publish_core_bbox_marker" value="true"/>
        <param name="publish_debug_markers" value="false"/>
    </node>

    <!-- Point-cloud merge and sensor frame. -->
    <node name="pointcloud_merger" pkg="ndt_slam" type="pointcloud_merger" output="screen">
        <rosparam command="load" file="$(find ndt_slam)/config/merger_params.yaml"/>
    </node>

    <node if="$(arg publish_rslidar_tf)"
          name="ndt_slam_rslidar_tf"
          pkg="tf"
          type="static_transform_publisher"
          args="0 0 0 0 0 0 base_link rslidar 100"/>

    <group if="$(arg use_rviz)">
        <node name="rviz" pkg="rviz" type="rviz"
              args="-d $(find ndt_slam)/launch/rviz.rviz"/>
    </group>

    <param name="mode" value="longterm_mapping"/>
    <param name="config_file" value="$(arg config_file)"/>
</launch>
