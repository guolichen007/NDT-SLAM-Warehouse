[Unit]
Description=NDT-SLAM long-term mapping
After=network-online.target roscore.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKSPACE@
EnvironmentFile=@ENV_FILE@
ExecStartPre=/bin/bash -lc 'mkdir -p "$NDT_SLAM_DATA_ROOT" "$ROS_LOG_DIR"'
ExecStart=/usr/bin/flock --no-fork --exclusive --nonblock "@DATA_ROOT@/.ndt-slam.lock" /bin/bash -lc 'source "$NDT_SLAM_WORKSPACE/devel/setup.bash" && exec rosrun ndt_slam ndt_slam_service_supervisor.py --runtime-status "$NDT_SLAM_DATA_ROOT/runtime_status.json" --evidence-file "$NDT_SLAM_DATA_ROOT/service_exit_classification.json" -- roslaunch ndt_slam warehouse_live_longterm_mapping.launch use_sim_time:=false use_rviz:=false persistent_map:=true use_ndt_recovery_watchdog:=true'
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
KillMode=mixed
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
